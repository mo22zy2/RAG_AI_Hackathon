{
  "risk_rules": [
    {
      "name": "emergency",
      "risk_level": "refuse_redirect",
      "reason": "possible_emergency",
      "patterns": [
        {
          "terms": [
            "cant breathe",
            "can't breathe",
            "cannot breathe",
            "blue lips",
            "blue face",
            "severe attack",
            "lifethreatening",
            "life-threatening",
            "life threatening",
            "unconscious",
            "collapsed",
            "chest pain",
            "emergency",
            "call an ambulance",
            "go to the er",
            "urgent help",
            "urgent care now",
            "status asthmaticus",
            "turning blue",
            "turned blue",
            "going blue",
            "look blue",
            "looks blue"
          ]
        },
        {
          "pattern": "\\b(lips|face|skin|fingertips)\\b.{0,30}\\b(blue|bluish|blue-ish)\\b"
        },
        {
          "pattern": "\\b(blue|bluish|blue-ish)\\b.{0,30}\\b(lips|face|skin|fingertips)\\b"
        },
        {
          "terms": [
            "لا أستطيع التنفس",
            "لا استطيع التنفس",
            "شفاه زرقاء",
            "نوبة شديدة",
