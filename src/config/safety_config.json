            "cat",
            "pet",
            "animal",
            "horse",
            "bird"
          ]
        }
      ]
    },
    {
      "name": "clearly_non_clinical",
      "risk_level": "refuse_redirect",
      "reason": "clearly_non_clinical",
      "when_not": [
        "asthma_scope",
