        },
        {
          "pattern": "\\b(dog|dogs|cat|cats|pet|pets|animal|animals|horse|horses|bird|birds)\\b.{0,40}\\b(dander|allergen|allergens|allergy|allergies|trigger|triggers|triggered|triggering|exacerbat\\w*|flare[-\\s]?up|expos(?:ure|ed))\\b"
