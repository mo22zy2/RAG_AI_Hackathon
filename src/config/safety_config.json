            "طوارئ",
            "اتصل بالإسعاف",
            "حالة طارئة"
          ],
          "boundary": false
        }
      ]
    },
    {
      "name": "personal_dosing",
      "risk_level": "refuse_redirect",
      "reason": "personal_medication_advice",
      "patterns": [
        {
          "terms": [
            "what should i take",
            "should i take",
            "can i take",
            "dose for me",
            "dosage for me",
            "prescribe",
            "increase my dose",
            "stop my medication"
          ]
        },
        {
          "terms": [
            "ماذا يجب أن آخذ",
            "هل يمكنني أن آخذ",
            "الجرعة المناسبة لي",
            "صف لي",
            "زيادة جرعتي",
            "أوقف دوائي"
          ],
          "boundary": false
        }
      ]
    },
    {
