APP_NAME="mini-RAG"
APP_VERSION="0.1"

# File upload limits
FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=16                          # MB
FILE_DEFAULT_CHUNK_SIZE=512000            # Bytes for upload streaming

# MongoDB
MONGODB_URL="mongodb://admin:admin@localhost:27017"
MONGODB_DATABASE="mini-rag"

# LLM Backend (OPENAI, COHERE, or OLLAMA via OpenAI-compatible API)
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"

# Set your API key if using OpenAI or Cohere (leave empty for Ollama local models)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

COHERE_API_KEY=""

# Model IDs
# For Ollama: GENERATION_MODEL_ID="gemma2:latest", EMBEDDING_MODEL_ID="nomic-embed-text:latest"
GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
# Dimensions: text-embedding-3-small=1536, qwen3-embedding:8b=4096, mxbai-embed-large:335m=1024, embed-multilingual-light-v3.0=384
EMBEDDING_MODEL_SIZE=1536

# Generation parameters
INPUT_DEFAULT_MAX_CHARS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# RAG retrieval and indexing
RETRIEVAL_TOP_K=10
ANSWER_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
MAX_CONTEXT_CHARS=6000
EMBEDDING_BATCH_SIZE=64
VECTOR_INSERT_BATCH_SIZE=64

# Vector Database
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=150
# HNSW (max ~2000 dims, faster search) or IVFFLAT (higher dims, lower build cost)
VECTOR_DB_INDEX_TYPE="IVFFLAT"

# Templates
DEFAULT_LANGUAGE="en"
